POSTGRES_DB=cointrol
POSTGRES_USER=cointrol
POSTGRES_PASSWORD=cointrol_local_password
PG_DB_URL=jdbc:postgresql://localhost:5432/cointrol
PG_DB_USERNAME=cointrol
PG_DB_PASSWORD=cointrol_local_password
# Gere um valor aleatorio conforme docs/SEGURANCA.md; CHANGE_ME falha de proposito no startup.
JWT_SECRET=CHANGE_ME
JWT_ACTIVE_KEY_ID=local-primary
JWT_PREVIOUS_KEYS=
JWT_ISSUER=cointrol-api
JWT_AUDIENCE=cointrol-client
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
LOGIN_MAXIMUM_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_DURATION_SECONDS=900
LOGIN_ATTEMPT_RETENTION_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAXIMUM_TRACKED_KEYS=100000
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTRATION_REQUESTS=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_API_REQUESTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60
SECURITY_AUDIT_RETENTION_DAYS=365
SECURITY_AUDIT_CLEANUP_CRON="0 15 3 * * *"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,http://127.0.0.1:4200
SWAGGER_ENABLED=true
